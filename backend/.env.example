PORT=5000
NODE_ENV=production
JWT_SECRET=your_production_jwt_secret_key_here

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digi_law_reporter
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digi_law_reporter

UPLOAD_PATH=uploads/
FRONTEND_URL=https://www.digilawreporter.in
APP_BASE_URL=https://www.digilawreporter.in

# Nodemailer Gmail SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=YOUR_GMAIL_EMAIL
MAIL_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
